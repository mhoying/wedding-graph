{
  "name": "wedding-graph",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "detect-bounds": "python3 scripts/detect_real_face_bounds.py",
    "measure-pixels": "python3 scripts/measure_output_pixels.py",
    "recalibrate-opencv": "./venv/bin/python scripts/recalibrate_with_opencv.py",
    "recalibrate-serial": "python3 scripts/recalibrate_all_guests_serial.py",
    "process-headshots": "python3 scripts/process_headshots.py",
    "update-headshot": "python3 scripts/update_headshot.py",
    "recalibrate": "python3 scripts/recalibrate_all_faces.py && npm run build",
    "audit-headshots": "python3 scripts/audit_and_recalibrate_headshots.py && npm run build",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist",
    "audit-issues": "node scripts/audit_and_sync_issues.js",
    "calculate-weights": "node scripts/calculate_tag_weights.js"
  },
  "dependencies": {
    "@tensorflow/tfjs": "^4.22.0",
    "@tensorflow/tfjs-backend-wasm": "^4.22.0",
    "@vladmandic/face-api": "^1.7.15",
    "d3-force": "^3.0.0",
    "lucide-react": "^1.33.0",
    "papaparse": "^5.6.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-force-graph-2d": "^1.29.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "canvas": "^3.2.3",
    "gh-pages": "^6.3.0",
    "jsdom": "^30.0.1",
    "oxlint": "^1.75.0",
    "puppeteer": "^25.10.0",
    "puppeteer-core": "^25.8.0",
    "terser": "^5.51.2",
    "vite": "^8.2.0"
  }
}
